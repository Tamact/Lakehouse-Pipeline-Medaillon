COMPOSE_PROJECT_NAME=lakehouse
TZ=Africa/Dakar

# ----------------------------------------------------------------------------
#  MinIO  (stockage objet S3-compatible)
# ----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Endpoint interne (nom de service docker) - JAMAIS localhost pour les conteneurs
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
# Buckets crees au demarrage par le service minio-init
RAW_BUCKET=raw                 # zone brute alimentee par NiFi (JSON)
WAREHOUSE_BUCKET=warehouse     # warehouse Iceberg (donnees Bronze/Silver/Gold)

# ----------------------------------------------------------------------------
#  PostgreSQL  (metadonnees Airflow + Nessie)
# ----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse123
# Bases creees par le script d'init (docker-entrypoint-initdb.d)
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_NESSIE_DB=nessie

# ----------------------------------------------------------------------------
#  Project Nessie  (catalogue versionne des tables Iceberg)
# ----------------------------------------------------------------------------
NESSIE_PORT=19120
NESSIE_URI=http://nessie:19120/api/v2
NESSIE_DEFAULT_BRANCH=main

# ----------------------------------------------------------------------------
#  Spark  (cluster : 1 master + 1 worker)
# ----------------------------------------------------------------------------
SPARK_MASTER_WEBUI_PORT=8081
SPARK_MASTER_PORT=7077
SPARK_WORKER_WEBUI_PORT=8082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3G
# Versions des dependances (compatibilite Spark 3.5 / Scala 2.12)
ICEBERG_VERSION=1.6.1
NESSIE_SPARK_VERSION=0.99.0

# ----------------------------------------------------------------------------
#  Apache Airflow  (orchestration)
# ----------------------------------------------------------------------------
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Cle Fernet (demo). En prod : `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
AIRFLOW_FERNET_KEY=Zp8kR2mN4xQ7vY1wB6tE9sH3jL5cF0dG8aU2iO4pX7k=
AIRFLOW__CORE__EXECUTOR=LocalExecutor
# API REST activee pour le declenchement evenementiel depuis NiFi (Partie 6, option B)
AIRFLOW_API_USER=nifi_trigger
AIRFLOW_API_PASSWORD=nifi_trigger_123

# ----------------------------------------------------------------------------
#  Apache NiFi  (ingestion)
# ----------------------------------------------------------------------------
NIFI_WEB_HTTPS_PORT=8443
# Acces single-user (choix documente : reproductibilite de la correction).
# Alternative "creds generes + docker logs" expliquee dans nifi/README.md.
NIFI_USERNAME=admin
NIFI_PASSWORD=nifiAdminPass2026   # >= 12 caracteres impose par NiFi single-user
NIFI_SENSITIVE_PROPS_KEY=changeMeToARandomKey0123456789

# ----------------------------------------------------------------------------
#  Dremio OSS  (moteur de requete SQL)
# ----------------------------------------------------------------------------
DREMIO_HTTP_PORT=9047
DREMIO_CLIENT_PORT=31010
DREMIO_FLIGHT_PORT=32010

# ----------------------------------------------------------------------------
#  Prometheus + Grafana  (supervision)
# ----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------------
#  Parametres fonctionnels du pipeline
# ----------------------------------------------------------------------------
# Source de donnees imposee
FAKESTORE_API_BASE=https://fakestoreapi.com
# Domaines couverts par le medaillon (>= 2 imposes)
LAKEHOUSE_DOMAINS=products,users,carts
# Reconstitution d'historique : nb de snapshots hebdomadaires (~6 mois = 26)
BACKFILL_WEEKS=26
